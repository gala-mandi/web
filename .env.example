# Copy to .env.local and change the values. Never commit .env.local.

# Base URL of the server API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Sentry error tracking (optional). Leave empty to turn it off. It is read at
# build time: after changing it on Vercel, redeploy.
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to Vercel's environment (production / preview) or NODE_ENV
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
